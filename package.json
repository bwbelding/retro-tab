{
  "name": "retro-tab",
  "version": "1.5.0",
  "private": true,
  "description": "Retro Build and Retro Polish: custom PowerPoint for Mac ribbon tabs (Office.js add-in).",
  "type": "module",
  "scripts": {
    "icons": "node scripts/build-icons.mjs",
    "manifests": "node scripts/build-manifests.mjs",
    "build": "tsc --noEmit && vite build && npm run icons && npm run manifests",
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate": "office-addin-manifest validate dist/manifest-build.xml && office-addin-manifest validate dist/manifest-polish.xml"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fluentui/react-components": "^9.74.9",
    "@fluentui/react-icons": "^2.0.343",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/office-js": "^1.0.611",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-xml-parser": "^5.11.2",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.5",
    "office-addin-manifest": "^3.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
